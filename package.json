{
  "name": "army-of-one",
  "version": "0.0.1",
  "private": true,
  "description": "A game where you control an army, one soldier at a time.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:purity": "node tools/check-purity-lint.mjs",
    "format": "prettier --write .",
    "gen:placeholders": "tsx tools/gen-placeholders.ts",
    "sim": "tsx tools/sim-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
